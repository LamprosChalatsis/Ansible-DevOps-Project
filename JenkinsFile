pipeline {
    agent any

    stages {
        stage('Deploy via Ansible') {
            steps {
                dir('ansible') {
                    sshagent(credentials: ['vm-deploy-key']) {
                        sh 'ansible-playbook -i hosts.yaml playbooks/deploy.yaml'
                    }
                }
            }
        }
        stage('Deploy K8s') {
            steps{
                dir('ansible') {
                    sh 'ansible-playbook -i hosts.yaml playbooks/k8s-deploy.yaml'
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment via Ansible completed.'
        }
        failure {
            echo 'Ansible deployment failed.'
        }
    }
}
